# ═══════════════════════════════════════════════════════════════════════════
# HMS — Environment Variables Template
#Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════════════════
# HMS — Production Environment Variables
# Copy to .env.prod
# NEVER COMMIT REAL VALUES
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hms
DB_USERNAME=hms_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── JWT / Security ────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ── AI Inference Sidecar ──────────────────────────────────────────────────
AI_SERVICE_BASE_URL=http://ai-sidecar:8000
AI_SERVICE_API_KEY=

# ── File Storage (MinIO) ──────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_MINIO_SECRET_KEY
MINIO_BUCKET_DOCUMENTS=hms-documents

# ── Email ─────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# ── SMS Provider ──────────────────────────────────────────────────────────
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────
OTEL_ENDPOINT=http://otel-collector:4317
GRAFANA_PASSWORD=CHANGE_GRAFANA_PASSWORD